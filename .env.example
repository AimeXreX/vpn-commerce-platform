PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram Bot API 10.2+
# توکن از BotFather و شناسه‌های عددی مدیران با کاما
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
TELEGRAM_ADMIN_IDS=
TELEGRAM_OWNER_IDS=
# عضویت اجباری؛ برای غیرفعال‌کردن خالی بگذارید
TELEGRAM_REQUIRED_CHANNEL=
TELEGRAM_REQUIRED_CHANNEL_URL=
# development: polling | production: webhook
TELEGRAM_MODE=
# برای production یک رشته تصادفی 32 تا 64 کاراکتری قرار دهید
TELEGRAM_WEBHOOK_SECRET=

# اطلاعات نمایش داده‌شده به خریدار
STORE_NAME=ProSySVPN
SUPPORT_ID=@your_support
CARD_NUMBER=6037-0000-0000-0000
CARD_HOLDER=نام صاحب کارت

# 3x-ui v3.2+ (از Settings > Security > API Token)
XUI_BASE_URL=https://panel.example.com:2053/your-path
XUI_API_TOKEN=
XUI_INBOUND_ID=1
XUI_PUBLIC_SUB_URL=https://panel.example.com:2096/your-sub-path
XUI_ALLOW_SELF_SIGNED=false

# NOWPayments (Dashboard > Settings > Payments/API keys)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=
# نرخ هر دلار به تومان؛ برای مبلغ دقیق به‌روز نگه دارید
NOWPAYMENTS_USD_RATE=

# در حالت true می‌توانید بدون پنل واقعی کل جریان را آزمایش کنید
DEMO_MODE=true
